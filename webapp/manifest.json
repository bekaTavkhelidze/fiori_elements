{
  "_version": "1.76.0",
  "sap.app": {
    "id": "fiorielements",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.20.0",
      "toolsId": "aa3266c6-c021-4e26-b706-bdd718d06fe2"
    },
    "dataSources": {
      "annotation": {
        "type": "ODataAnnotation",
        "uri": "annotations/annotation.xml",
        "settings": {
          "localUri": "annotations/annotation.xml"
        }
      },
      "mainService": {
        "uri": "/root/",
        "type": "OData",
        "settings": {
          "annotations": ["annotation"],
          "localUri": "localService/mainService/metadata.xml",
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "localfiorielementv4-display": {
          "semanticObject": "localfiorielementv4",
          "action": "show",
          "title": "{{localfiorielementv4-display.flpTitle}}",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.143.2",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {},
        "sap.fe.macros": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "fiorielements.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": []
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "StoresList",
          "target": "StoresList"
        },
        {
          "pattern": "Stores({key}):?query:",
          "name": "StoresObjectPage",
          "target": "StoresObjectPage"
        },
        {
          "pattern": "Stores({key})/Products({key2}):?query:",
          "name": "ProductsObjectPage",
          "target": "ProductsObjectPage"
        }
      ],
      "targets": {
        "StoresList": {
          "type": "Component",
          "id": "StoresList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/Stores",
              "variantManagement": "Page",
              "navigation": {
                "Stores": {
                  "detail": {
                    "route": "StoresObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable"
                  },
                  "columns": {
                    "CustomColumnListReport": {
                      "header": "{i18n>customValue}",
                      "position": {
                        "anchor": "DataField::Email",
                        "placement": "After"
                      },
                      "template": "fiorielements.ext.fragment.CustomColumnListReport"
                    }
                  },
                  "actions": {
                    "Function_Import": {
                      "press": "fiorielements.ext.controller.Action.OnCallAction",
                      "visible": true,
                      "enabled": true,
                      "requiresSelection": false,
                      "text": "{i18n>callTheAction}"
                    }
                  }
                },
                "@com.sap.vocabularies.UI.v1.SelectionFields": {
                  "filterFields": {
                    "CustomFIlter": {
                      "label": "{i18n>floorAreaAbove2000}",
                      "property": "FloorArea",
                      "template": "fiorielements.ext.fragment.ListReport",
                      "required": false,
                      "position": {
                        "placement": "Before",
                        "anchor": "FloorArea"
                      }
                    }
                  }
                }
              },
              "initialLoad": "Enabled"
            }
          }
        },
        "StoresObjectPage": {
          "type": "Component",
          "id": "StoresObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "contextPath": "/Stores",
              "navigation": {
                "Products": {
                  "detail": {
                    "route": "ProductsObjectPage"
                  }
                }
              },
              "variantManagement": "Control",
              "editableHeaderContent": true,
              "content": {
                "header": {
                  "anchorBarVisible": true,
                  "visible": true,
                  "facets": {
                    "CustomHeaderFacet": {
                      "template": "fiorielements.ext.fragment.CustomHeaderFacet",
                      "position": {
                        "placement": "After",
                        "anchor": "Name"
                      },
                      "title": "Custom facet",
                      "stashed": false,
                      "requestGroupId": "Heroes",
                      "flexSettings": {
                        "designtime": "Default"
                      }
                    }
                  }
                },
                "body": {
                  "sections": {
                    "CustomSectionOP": {
                      "template": "fiorielements.ext.fragment.CustomSectionOP",
                      "position": {
                        "placement": "After",
                        "anchor": "Products"
                      },
                      "title": "Custom Section _ Macros Table"
                    }
                  }
                }
              },
              "showRelatedApps": false,
              "controlConfiguration": {
                "Products/@com.sap.vocabularies.UI.v1.LineItem#Products": {
                  "tableSettings": {
                    "enableFullScreen": true,
                    "enableMassEdit": false,
                    "selectionLimit": 0,
                    "selectAll": true,
                    "selectionMode": "Single",
                    "type": "ResponsiveTable",
                    "creationMode": {
                      "name": "NewPage"
                    },
                    "personalization": {
                      "filter": true,
                      "sort": false
                    },
                    "quickVariantSelection": {
                      "hideTableTitle": false,
                      "paths": [{}]
                    }
                  },
                  "actions": {
                    "Function_Import": {
                      "press": "fiorielements.ext.controller.Action.OnCallAction",
                      "visible": true,
                      "enabled": true,
                      "requiresSelection": false,
                      "text": "{i18n>callTheAction}"
                    }
                  }
                },
                "@com.sap.vocabularies.UI.v1.FieldGroup#Store": {
                  "fields": {
                    "CustomFieldOP": {
                      "template": "fiorielements.ext.fragment.CustomFieldOP",
                      "position": {
                        "placement": "After",
                        "anchor": "DataField::Name"
                      },
                      "label": "{i18n>customField}"
                    }
                  }
                }
              }
            }
          }
        },
        "ProductsObjectPage": {
          "type": "Component",
          "id": "ProductsObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "contextPath": "/Stores/Products",
              "navigation": {},
              "editableHeaderContent": true,
              "content": {
                "header": {
                  "visible": true,
                  "anchorBarVisible": false
                }
              },
              "sectionLayout": "Page"
            }
          }
        }
      }
    },
    "extends": {
      "extensions": {
        "sap.ui.viewExtensions": {
          "sap.suite.ui.generic.template.ListReport.view.ListReport": {}
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  }
}
